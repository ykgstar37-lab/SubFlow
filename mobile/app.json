{
  "expo": {
    "name": "SubFlow",
    "slug": "subflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "subflow",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C4DCF2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.mysubflow",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C4DCF2"
      },
      "edgeToEdgeEnabled": true,
      "package": "app.mysubflow",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#4A90D9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "오류 신고에 첨부할 화면 사진을 고를 때만 사진 보관함을 엽니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ee9a4e67-7a1e-4ad7-9cd6-6c33613b6426"
      },
      "router": {}
    },
    "owner": "yoongyeongeun",
    "updates": {
      "url": "https://u.expo.dev/ee9a4e67-7a1e-4ad7-9cd6-6c33613b6426"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
